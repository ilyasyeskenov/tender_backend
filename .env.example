# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Configuration (Required for embeddings and chat)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large

# AI Provider (openai or gemini)
AI_PROVIDER=openai

# Gemini Configuration (Optional - only if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp

# Server Configuration (Optional - defaults shown)
# PORT is set automatically by Railway in production
# TENDER_BACKEND_PORT=8001  # For local development only
